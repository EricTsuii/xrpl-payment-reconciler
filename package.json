{
  "name": "xrpl-payment-reconciler",
  "version": "0.1.0",
  "description": "Validated XRPL payment reconciliation with WebSocket ingestion, gap recovery, idempotent Postgres state and signed webhooks.",
  "license": "Apache-2.0",
  "private": true,
  "type": "commonjs",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm test:unit",
    "test:unit": "jest --config test/jest.unit.config.cjs --runInBand",
    "test:integration": "jest --config test/jest.integration.config.cjs --runInBand",
    "test:e2e": "jest --config test/jest.e2e.config.cjs --runInBand",
    "test:testnet": "tsx test/testnet-smoke.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build"
  },
  "dependencies": {
    "@nestjs/common": "12.0.2",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.2",
    "@nestjs/platform-fastify": "12.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.4",
    "pg": "8.23.0",
    "redis": "6.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "xrpl": "5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.1",
    "@nestjs/testing": "12.0.2",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.10",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jest": "29.7.0",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
